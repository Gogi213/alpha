{
  "env": {
    "CLAUDE_CODE_PROMPT_CACHE_TTL": "1h",
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "1h"
  },
  "skillOverrides": {
    "autopilot": "off",
    "brand-guidelines": "off",
    "canvas-design": "off",
    "domain-modeling": "off",
    "frontend-design": "off",
    "grill-me": "off",
    "grill-with-docs": "off",
    "grilling": "off",
    "implement": "off",
    "setup-matt-pocock-skills": "off",
    "theme-factory": "off",
    "to-spec": "off",
    "to-tickets": "off",
    "typesafe-ai": "off",
    "ui-ux-pro-max": "off",
    "wayfinder": "off",
    "mp-code-review": "off",
    "plan-autopilot": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off",
    "init": "off",
    "security-review": "off",
    "claude-api": "off"
  },
  "enabledPlugins": {
    "role-play-vibing@role-play-vibing": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/bare_systemd_run.py\""
          }
        ]
      }
    ]
  }
}
