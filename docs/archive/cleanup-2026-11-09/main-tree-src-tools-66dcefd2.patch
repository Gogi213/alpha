+fn guard_upd(snap: bool, u: u64, bids: &[(i64, i64)], asks: &[(i64, i64)]) -> crate::book::Update {
+    crate::book::Update {
+        is_snapshot: snap,
+        depth: 50,
+        u,
+        seq: u,
+        cts_ms: 1_000 + u as i64,
+        bids: bids.to_vec(),
+        asks: asks.to_vec(),
+    }
