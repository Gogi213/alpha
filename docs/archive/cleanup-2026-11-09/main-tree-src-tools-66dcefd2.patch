+/// Сколько первых ошибок применения печатать на файл (остальные — только счётчик).
+const APPLY_ERR_PRINT: u64 = 3;
+
+/// Применение обновлений одного файла с ресинком (TK-408, аудит TK-404 C2).
+///
+/// Раньше ошибка `Book::apply` молча обрывала остаток файла (у PEPE/BONK спота
+/// это стерло почти все сутки). Теперь ошибка считается и печатается (первые
+/// `APPLY_ERR_PRINT`), книга считается сломанной, обновления пропускаются
+/// (`skipped`) до следующего снимка (`is_snapshot` или `u = 1`) — он перезаписывает
+/// книгу целиком. Файл без ошибок идёт ровно как прежде.
+#[derive(Debug, Default, Clone, Copy)]
+pub(crate) struct ApplyGuard {
+    pub errors: u64,
+    pub skipped: u64,
+    broken: bool,
+}
+
+impl ApplyGuard {
+    /// `true` — обновление применено, книгу можно читать.
+    pub(crate) fn apply(
+        &mut self,
+        book: &mut crate::book::Book,
+        up: &crate::book::Update,
+        path: &Path,
+    ) -> bool {
+        if self.broken && !(up.is_snapshot || up.u == 1) {
+            self.skipped += 1;
+            return false;
+        }
+        match book.apply(up) {
+            Ok(()) => {
+                self.broken = false;
+                true
+            }
+            Err(e) => {
+                self.errors += 1;
+                self.skipped += 1;
+                self.broken = true;
+                if self.errors <= APPLY_ERR_PRINT {
+                    eprintln!(
+                        "{}: ошибка применения обновления u={} snap={} cts_ms={}: {e:?} —                          пропуск до следующего снимка",
+                        path.display(),
+                        up.u,
+                        up.is_snapshot,
+                        up.cts_ms
+                    );
+                }
+                false
+            }
+        }
+    }
+
+    /// Книга сейчас сломана (ждём снимок).
+    pub(crate) fn is_broken(&self) -> bool {
+        self.broken
+    }
+
+    /// Итог файла в stderr, если ошибки были (молчаливого пути нет).
+    pub(crate) fn report(&self, path: &Path) {
+        if self.errors > 0 {
+            eprintln!(
+                "{}: ошибок применения {}, пропущено обновлений {}",
+                path.display(),
+                self.errors,
+                self.skipped
+            );
+        }
+    }
+
+    pub(crate) fn add(&mut self, o: &Self) {
+        self.errors += o.errors;
+        self.skipped += o.skipped;
+    }
+}
