+/// TK-408: ошибка применения не обрывает файл — счёт, пропуск до снимка, ресинк по нему.
+#[test]
+fn apply_guard_resyncs_on_next_snapshot() {
+    let mut book = crate::book::Book::new(1, 1);
+    let mut g = super::parts::ApplyGuard::default();
+    let p = Path::new("x.binlog");
+    // дельта до снимка — SequenceGap: ошибка, книга сломана
+    assert!(!g.apply(&mut book, &guard_upd(false, 2, &[(10, 1)], &[]), p));
+    assert!(g.is_broken());
+    // дельты до снимка пропускаются без новых ошибок
+    assert!(!g.apply(&mut book, &guard_upd(false, 3, &[(10, 1)], &[]), p));
+    assert_eq!((g.errors, g.skipped), (1, 2));
+    // снимок чинит книгу
+    assert!(g.apply(&mut book, &guard_upd(true, 1, &[(10, 1)], &[(11, 1)]), p));
+    assert!(!g.is_broken());
+    assert!(g.apply(&mut book, &guard_upd(false, 2, &[(9, 1)], &[]), p));
+    assert_eq!((g.errors, g.skipped), (1, 2));
+    // пересечение — ошибка, снова ресинк
+    assert!(!g.apply(&mut book, &guard_upd(false, 3, &[(12, 1)], &[]), p));
+    assert_eq!(g.errors, 2);
+    assert!(g.apply(&mut book, &guard_upd(true, 1, &[(5, 1)], &[(6, 1)]), p));
+}
