+def test_make_ctx_store_and_cache_default_only_for_new_binary():
+    with tempfile.TemporaryDirectory() as tmp:
+        sym = os.path.join(tmp, "symbols.txt")
+        with open(sym, "w", encoding="utf-8") as f:
