# Сырьё записи — только каталог в корне репозитория. Якорь `/` обязателен: без него
# правило съедало и `vendor/hftbacktest/src/backtest/data/` — модуль вендоренного
# крейта, без которого его сборка падает (E0583; найдено сборкой на счётной машине 20.09).
/data/
target/
.autopilot/serve.*

# мусор от правок
*.bak
*.orig
*.rej
.autopilot/*.pid
.claude/worktrees/
# временные артефакты проверок страницы (профиль Chrome, скриншоты)
.tmp-*/
# индекс плагина dsh-code-index (локальный кеш, не часть проекта)
.dsh-code-index/
__pycache__/
