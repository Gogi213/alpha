[Unit]
Description=alpha netwatch: 1 Hz RTT to exchange edges + ICMP to gateway (G-022)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/alpha/netwatch/netwatch.py --out /data/netwatch
Restart=always
RestartSec=5
Nice=10
CPUQuota=5%
MemoryMax=100M

[Install]
WantedBy=multi-user.target
