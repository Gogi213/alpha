function drawDev(cv,r,d){
  const {c,W,H}=setup(cv,170);
  const h=d.dev,lo=h.lo,stp=h.step,n=h.v.length,tot=h.v.reduce((a,b)=>a+b,0)+h.under+h.over||1;
  const L=40,R=18,T=8,B=24,pw=W-L-R,ph=H-T-B;
  const lg=v=>Math.log10(Math.max(v,1e-6)),yhi=-0.3,ylo=-5.3;   // доля времени, 10^-5 … 0,5
  const Y=v=>T+ph-(Math.max(lg(v),ylo)-ylo)/(yhi-ylo)*ph,X=i=>L+i/n*pw;
  c.strokeStyle=LINE;c.fillStyle=MUT;c.textAlign='right';c.lineWidth=1;
  [[-1,'10 %'],[-2,'1 %'],[-3,'0,1 %'],[-4,'0,01 %']].forEach(([e,l])=>{const y=T+ph-(e-ylo)/(yhi-ylo)*ph;c.beginPath();c.moveTo(L,y);c.lineTo(W-R,y);c.stroke();c.fillText(l,L-5,y+4)});
  const bw=Math.max(1,pw/n-.5);
  h.v.forEach((v,i)=>{if(v<=0)return;const mid=lo+(i+.5)*stp;c.fillStyle=mid>0?SELL:BUY;c.globalAlpha=.75;const y=Y(v/tot);c.fillRect(X(i),y,bw,T+ph-y)});c.globalAlpha=1;
  const x0=L+(0-lo)/(stp*n)*pw;c.strokeStyle=MUT;c.beginPath();c.moveTo(x0,T);c.lineTo(x0,T+ph);c.stroke();
  c.fillStyle=MUT;[-1,-.5,0,.5,1].forEach(q=>{const v=lo+(0.5+q/2)*stp*n;c.textAlign=q===1?'right':q===-1?'left':'center';c.fillText((v>0?'+':v<0?'−':'')+nf(Math.abs(v),0),L+(0.5+q/2)*pw,H-6)});
}
// ---------- время схождения ----------
function drawConv(cv,e){
  const {c,W,H}=setup(cv,190);const bins=e.bins.concat([e.cens]);
  const L=34,R=34,T=14,B=52,pw=W-L-R,ph=H-T-B;const mx=Math.max(1,...bins);
  const lab=BINL.concat(['не сошлись']),n=bins.length,bw=pw/n;
  c.strokeStyle=LINE;c.fillStyle=MUT;c.textAlign='right';
  [0,.5,1].forEach(q=>{const y=T+ph-q*ph;c.beginPath();c.moveTo(L,y);c.lineTo(W-R,y);c.stroke();c.fillText(ni(mx*q),L-5,y+4)});
  bins.forEach((v,i)=>{const h=v/mx*ph,x=L+i*bw+3;c.fillStyle=i===n-1?ACC:BINC[i];c.fillRect(x,T+ph-h,bw-6,h);if(v){c.fillStyle=INK;c.textAlign='center';c.fillText(ni(v),x+(bw-6)/2,T+ph-h-4)}
    c.save();c.fillStyle=MUT;c.translate(x+(bw-6)/2+3,T+ph+8);c.rotate(Math.PI/4);c.textAlign='left';c.font='11px system-ui,Segoe UI,Arial';c.fillText(lab[i],0,0);c.restore()});
}
