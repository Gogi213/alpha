function rxcmp(){
  if(!A.rxcmp)return '';
  const rows=A.rxcmp.map(x=>'<tr><td>'+tag(x.a,x.b)+'</td><td>'+nf(x.e.per_h,1)+'</td><td>'+nf(x.rx.per_h,1)+'</td><td>'+dur(x.e.p50)+'</td><td>'+dur(x.rx.p50)+'</td><td>'+dur(x.e.p90)+'</td><td>'+dur(x.rx.p90)+'</td><td>'+pc(x.e.share,2)+'</td><td>'+pc(x.rx.share,2)+'</td></tr>').join('');
  return '<h3 style="margin-top:20px">Сверка: время события биржи и время приёма на srv (порог '+lvName(FEE)+' bps)</h3><div class="src" style="margin-bottom:6px">«Приём» — то, что увидел бы бот на этой машине: записи старше 2 с и устаревшие по E отброшены, часы одни — srv.</div>'+
   '<table class="e" style="max-width:820px"><thead><tr><th>пара</th><th>эпизодов на монету в час: событие</th><th>приём</th><th>схождение p50: событие</th><th>приём</th><th>p90: событие</th><th>приём</th><th>расхождение ≥ порога, % времени: событие</th><th>приём</th></tr></thead><tbody>'+rows+'</tbody></table>';
}
// ---------- вкладки ----------
function tab(a){
  $('p-a').hidden=!a;$('p-h').hidden=a;$('tab-a').classList.toggle('on',a);$('tab-h').classList.toggle('on',!a);
  location.hash=a?'arb':'';
  if(a){aggs();if(window._redraw)window._redraw()}else if(window.render)window.render();
}
$('tab-a').onclick=()=>tab(true);$('tab-h').onclick=()=>tab(false);
head();lvl();filters();tables();defs();
window.addEventListener('resize',()=>{if(!$('p-a').hidden){aggs();if(window._redraw)window._redraw()}});
if(location.hash==='#arb')tab(true);
// для проверки: открыть монету из адресной строки (#arb=<i>)
const m=location.hash.match(/arb-open=(\d+)/);if(m){tab(true);st.open=+m[1];coinsTable();detail(st.open)}
window._arb={st,detail,coinsTable,tables};
})();
</script>
