// ---------- график раздвижки (как в viking: полосы min–max баров, линия закрытия, центр точками, пороги пунктиром) ----------
function niceTicks(lo,hi,n=5){const sp=(hi-lo)||1,raw=sp/n,p=Math.pow(10,Math.floor(Math.log10(raw))),m=raw/p,st=(m<1.5?1:m<3?2:m<7?5:10)*p;const a=[];for(let v=Math.ceil(lo/st)*st;v<=hi+1e-9;v+=st)a.push(v);return {a,st}}
function setup(cv,h){const dpr=window.devicePixelRatio||1,W=cv.parentNode.clientWidth;cv.style.height=h+'px';cv.width=Math.round(W*dpr);cv.height=Math.round(h*dpr);const c=cv.getContext('2d');c.setTransform(dpr,0,0,dpr,0,0);c.clearRect(0,0,W,h);c.font='12px system-ui,Segoe UI,Arial';return {c,W,H:h}}
function bandset(){return 0}
function drawSpread(cv,tipEl,r,d){
  const b=d['tf'+st.tf]||d.tf5,{c,W,H}=setup(cv,330);
  const L=54,R=12,T=10,B=26,pw=W-L-R,ph=H-T-B,t0=A.t0/1000,t1=A.t1/1000,X=t=>L+(t-t0)/(t1-t0)*pw;
  const step=st.tf*60;
  // шкала: 2–98 процентили полос, чтобы редкие выбросы не сплющивали картину; шире — только чтобы влезли центр ± порог и линии закрытия
  const lows=[],highs=[];let cmin=1e9,cmax=-1e9,amin=1e9,amax=-1e9;
  b.t.forEach((t,i)=>{const s=b.S[i],u=b.B[i],cc=b.c[i];lows.push(Math.min(s[2],u[2])/10);highs.push(Math.max(s[1],u[1])/10);amin=Math.min(amin,s[2]/10,u[2]/10);amax=Math.max(amax,s[1]/10,u[1]/10);if(cc!=null){cmin=Math.min(cmin,cc/10-LV[st.lv]);cmax=Math.max(cmax,cc/10+LV[st.lv])}});
  const q=(a,p)=>{const s=a.slice().sort((x,y)=>x-y);return s[Math.min(s.length-1,Math.floor(p*s.length))]};
  let lo=Math.min(q(lows,.02),cmin),hi=Math.max(q(highs,.98),cmax);
  const clipped=amin<lo-1e-9||amax>hi+1e-9;
  const pd=(hi-lo)*.05||1;lo-=pd;hi+=pd;
  const clampY=v=>Math.max(lo,Math.min(hi,v));
  const Y=v=>T+ph-(clampY(v)-lo)/(hi-lo)*ph;
  c.strokeStyle=LINE;c.lineWidth=1;c.fillStyle=MUT;c.textAlign='right';
  const tk=niceTicks(lo,hi);tk.a.forEach(v=>{const y=Y(v);c.beginPath();c.moveTo(L,y);c.lineTo(W-R,y);c.stroke();c.fillText(nf(v,tk.st<1?1:0),L-6,y+4)});
  if(lo<0&&hi>0){c.strokeStyle=MUT;c.beginPath();c.moveTo(L,Y(0));c.lineTo(W-R,Y(0));c.stroke()}
  c.fillStyle=MUT;for(let i=0;i<=4;i++){c.textAlign=i===0?'left':i===4?'right':'center';c.fillText(hm(t0+(t1-t0)*i/4),L+pw*i/4,H-8)}
  // дыры — нет ни одного обновления
  c.save();c.globalAlpha=.16;c.fillStyle=MUT;
  for(let i=1;i<b.t.length;i++){const g=b.t[i]-b.t[i-1];if(g>step*3){c.fillRect(X(b.t[i-1]+step),T,Math.max(1,X(b.t[i])-X(b.t[i-1]+step)),ph)}}
  c.restore();
  const bw=Math.max(1,pw*step/(t1-t0)-0.5);
  const band=(arr,color)=>{c.globalAlpha=.35;c.fillStyle=color;b.t.forEach((t,i)=>{const hi_=arr[i][1]/10,lo_=arr[i][2]/10;c.fillRect(X(t),Y(hi_),bw,Math.max(1,Y(lo_)-Y(hi_)))});c.globalAlpha=1;c.strokeStyle=color;c.lineWidth=1.4;c.beginPath();b.t.forEach((t,i)=>{const x=X(t)+bw/2,y=Y(arr[i][3]/10);i?c.lineTo(x,y):c.moveTo(x,y)});c.stroke()};
  band(b.S,SELL);band(b.B,BUY);
  // центр и границы входа (центр ± порог)
  const poly=(off,dash,color,lw)=>{c.save();c.strokeStyle=color;c.lineWidth=lw;c.setLineDash(dash);c.beginPath();let on=false;b.t.forEach((t,i)=>{const cc=b.c[i];if(cc==null){on=false;return}const x1=X(t),x2=X(t)+bw,y=Y(cc/10+off);if(!on){c.moveTo(x1,y);on=true}else c.lineTo(x1,y);c.lineTo(x2,y)});c.stroke();c.restore()};
  poly(0,[2,3],MUT,1);poly(LV[st.lv],[6,4],SELL,1);poly(-LV[st.lv],[6,4],BUY,1);
  c.save();c.fillStyle=MUT;c.textAlign='left';c.fillText(clipped?'шкала обрезана: выбросы '+sg(amin,0)+' … '+sg(amax,0)+' bps за краем':'',L+6,T+12);c.restore();
  cv._g={b,L,pw,t0,t1,X,Y,T,ph,step,H};
}
function hoverSpread(cv,tipEl){
  cv.onmousemove=e=>{
    const g=cv._g;if(!g)return;const rc=cv.getBoundingClientRect(),x=e.clientX-rc.left,t=g.t0+(x-g.L)/g.pw*(g.t1-g.t0);
    let bi=-1,bd=1e18;g.b.t.forEach((tt,i)=>{const dd=Math.abs(tt+g.step/2-t);if(dd<bd){bd=dd;bi=i}});
    if(bi<0||bd>g.step*1.5){tipEl.style.opacity=0;return}
    const s=g.b.S[bi],u=g.b.B[bi],cc=g.b.c[bi];
    tipEl.innerHTML='<b>'+hm(g.b.t[bi])+' – '+hm(g.b.t[bi]+g.step)+'</b><br><span style="color:#8fb4ff">Sell</span> '+sg(s[3]/10)+' <span class="m">(мин '+sg(s[2]/10)+' · макс '+sg(s[1]/10)+')</span><br><span style="color:#ffb066">Buy</span> '+sg(u[3]/10)+' <span class="m">(мин '+sg(u[2]/10)+' · макс '+sg(u[1]/10)+')</span><br><span class="m">центр '+(cc==null?'—':sg(cc/10))+' bps</span>';
    tipEl.style.opacity=1;const w=tipEl.offsetWidth;tipEl.style.left=Math.min(Math.max(x-w/2,0),rc.width-w)+'px';tipEl.style.top=(g.T+4)+'px';
  };
  cv.onmouseleave=()=>tipEl.style.opacity=0;
}
