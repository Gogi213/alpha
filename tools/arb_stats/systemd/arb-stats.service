[Unit]
Description=G-022 вкладка «Арбитраж»: почасовой счёт (tools/arb_stats/arb_live.py)

[Service]
Type=oneshot
WorkingDirectory=/opt/arb-tab/tools/arb_stats
ExecStart=/usr/bin/python3 /opt/arb-tab/tools/arb_stats/arb_live.py /data/arb-tab/live 3
Nice=15
CPUQuota=300%
MemoryMax=20G
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3000
