{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ход работ — блок наверху страницы CatBoost П-42 (srv:8090)",
  "description": "Файл /data/pages/ml/data/progress.json; копия-источник в репозитории — tools/p42/ml_progress.json. Тексты — по-русски, простыми словами; в строки numbers и next попадают только принятые цифры (результатов, которых ещё нет, не писать).",
  "type": "object",
  "additionalProperties": false,
  "required": ["updated", "headline", "stages", "targets"],
  "properties": {
    "updated": {"type": "string", "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$", "description": "дата обновления, ДД.ММ.ГГГГ"},
    "headline": {"type": "string", "minLength": 1, "description": "одна-две фразы: что сейчас происходит"},
    "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}, "description": "линия этапов слева направо"},
    "targets": {"$ref": "#/$defs/targets"}
  },
  "$defs": {
    "status": {"enum": ["done", "running", "waiting"], "description": "готово / идёт / ждёт"},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "answers", "numbers", "next"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "номер задачи или окно, например TK-598"},
        "title": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "answers": {"type": "string", "minLength": 1, "description": "на какой вопрос отвечает этап — одно предложение"},
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t", "s"],
            "properties": {"t": {"type": "string", "minLength": 1}, "s": {"$ref": "#/$defs/status"}}
          },
          "description": "необязательно: шаги внутри этапа"
        },
        "numbers": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "ключевые числа; пусто — на странице «Цифр пока нет»"},
        "next": {"type": "string", "minLength": 1, "description": "что дальше"}
      }
    },
    "cell": {"enum": ["pass", "fail", "na"], "description": "первый фильтр: прошла / не прошла / не считается"},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "note", "rows"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1, "description": "как читать таблицу"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "what", "long", "short"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "what": {"type": "string", "minLength": 1, "description": "что предсказывает, простыми словами"},
              "long": {"$ref": "#/$defs/cell"},
              "short": {"$ref": "#/$defs/cell"},
              "long_note": {"type": "string"},
              "short_note": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
