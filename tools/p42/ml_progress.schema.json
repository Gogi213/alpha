{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ход работ — блок наверху страницы CatBoost П-42 (srv:8090)",
  "description": "Файл /data/pages/ml/data/progress.json; копия-источник в репозитории — tools/p42/ml_progress.json. Тексты — по-русски, простыми словами; в строки numbers и next попадают только принятые цифры (результатов, которых ещё нет, не писать).",
  "type": "object",
  "additionalProperties": false,
  "required": ["updated", "headline", "where", "stages", "targets"],
  "properties": {
    "updated": {"type": "string", "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$", "description": "дата обновления, ДД.ММ.ГГГГ"},
    "headline": {"type": "string", "minLength": 1, "description": "одна-две фразы: что сейчас происходит"},
    "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}, "description": "линия этапов слева направо"},
    "targets": {"$ref": "#/$defs/targets"},
    "where": {"$ref": "#/$defs/where"},
    "feature": {"$ref": "#/$defs/feature"}
  },
  "$defs": {
    "status": {"enum": ["done", "running", "waiting"], "description": "готово / идёт / ждёт"},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "answers", "numbers", "next"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "номер задачи или окно, например TK-598"},
        "title": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "group": {"type": "string", "minLength": 1, "description": "необязательно (TK-624): заголовок группы; подряд идущие этапы с одним group рисуются под одним заголовком, группы не повторяются"},
        "answers": {"type": "string", "minLength": 1, "description": "на какой вопрос отвечает этап — одно предложение"},
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t", "s"],
            "properties": {"t": {"type": "string", "minLength": 1}, "s": {"$ref": "#/$defs/status"}}
          },
          "description": "необязательно: шаги внутри этапа"
        },
        "numbers": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "ключевые числа; пусто — на странице «Цифр пока нет»"},
        "next": {"type": "string", "minLength": 1, "description": "что дальше"}
      }
    },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "lead", "table_title", "table_note", "rows", "candidate", "broken", "next"],
      "description": "TK-624: блок «Где мы» над ходом работ. Цифры таблицы и кривых берутся из data/bases.json (tk624_table.py), здесь — только тексты; $ и шарп, без бп.",
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "lead": {"type": "string", "minLength": 1},
        "table_title": {"type": "string", "minLength": 1},
        "table_note": {"type": "string", "minLength": 1},
        "universe": {"type": "object", "additionalProperties": false, "required": ["title", "note"], "properties": {"title": {"type": "string", "minLength": 1}, "note": {"type": "string", "minLength": 1}}, "description": "необязательно: таблицы по вселенным TK-621 (данные — data/universe.json)"},
        "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"enum": ["L_base", "S_base", "S_mk1"]}, "name": {"type": "string", "minLength": 1}}}},
        "candidate": {"$ref": "#/$defs/whbox"},
        "broken": {"$ref": "#/$defs/whbox"},
        "next": {"$ref": "#/$defs/whbox"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "lead", "current"],
      "description": "TK-624: блок «Признак: успешные пробои монеты» — что считается сейчас (TK-625) и что было в TK-604.",
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "lead": {"type": "string", "minLength": 1},
        "current": {"type": "object", "additionalProperties": false, "required": ["title", "status", "text"], "properties": {
          "title": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/status"}, "text": {"type": "string", "minLength": 1},
          "table": {"type": "object", "additionalProperties": false, "required": ["cols", "rows"], "properties": {"cols": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "string"}}}}}}}
      }
    },
    "whbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "items": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": false, "required": ["t", "s"], "properties": {"t": {"type": "string", "minLength": 1}, "s": {"type": "string", "minLength": 1}}}]}}
      }
    },
    "cell": {"enum": ["pass", "fail", "na"], "description": "первый фильтр: прошла / не прошла / не считается"},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "note", "rows"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1, "description": "как читать таблицу"},
        "result_title": {"type": "string", "minLength": 1, "description": "необязательно: заголовок колонки с итогом чтения (колонка показывается, если задан)"},
        "result_none": {"type": "string", "description": "текст в колонке итога для строки без результатов"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "what", "long", "short"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "what": {"type": "string", "minLength": 1, "description": "что предсказывает, простыми словами"},
              "long": {"$ref": "#/$defs/cell"},
              "short": {"$ref": "#/$defs/cell"},
              "result": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"long": {"type": "string", "minLength": 1}, "short": {"type": "string", "minLength": 1}},
                "description": "необязательно: итог чтения по сторонам — только принятые цифры"
              },
              "long_note": {"type": "string"},
              "short_note": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
