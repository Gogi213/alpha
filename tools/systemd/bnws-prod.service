[Unit]
Description=TK-527 Binance WS collector (G-022)
After=network-online.target
Wants=network-online.target

[Service]
# Те же пользователь (root), каталоги и аргументы, что у прежнего временного юнита systemd-run; Restart=always — поднимется и после перезагрузки сервера.
# Код — /root/bnws (копия tools/collector ветки), данные — /data/bnws, health — /data/health/binance.json.
Restart=always
RestartSec=10s
TimeoutStopSec=40s
# Остановка: SIGTERM только главному процессу; он сам один раз останавливает шарды-детей (они закрывают файлы суток), и только потом выходит. KillMode по умолчанию (control-group) слал бы детям SIGTERM второй раз.
KillMode=mixed
ExecStart=/root/bnws-venv/bin/python /root/bnws/binance_ws.py --root /data/bnws --health /data/health/binance.json --lanes 2

[Install]
WantedBy=multi-user.target
