[Unit]
Description=Alpha: общий потолок памяти ночных сеток на деке (все процессы вместе)

[Slice]
# 22.09: семь параллельных сеток с потолком 4G на каждую в сумме переросли 14.8 ГБ дека — система
# ушла в своп и перестала отвечать по ssh. Потолок — на все сетки вместе: MemoryHigh тормозит
# (реклейм внутри среза), MemoryMax — OOM внутри среза, а не у системы; остаток — ОС, Steam, sshd.
MemoryHigh=9G
MemoryMax=10G
MemorySwapMax=0
