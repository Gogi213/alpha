[Unit]
Description=alpha bus watcher: units tk*/alpha-* and /data/progress -> event bus (TK-045)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/alpha-compute/bus/watcher.py --host HOSTNAME
Restart=always
RestartSec=3
CPUQuota=3%
MemoryMax=100M

[Install]
WantedBy=multi-user.target
